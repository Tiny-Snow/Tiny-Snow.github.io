<div class="news">
  {% if site.news != blank %}
    {% assign news_size = site.news | size %}
    {% assign news_visible_items = site.announcements.visible_items | default: 10 | at_least: 1 | at_most: 10 %}
    <div
      class="table-responsive{% if include.limit and site.announcements.scrollable %} news-scrollable{% endif %}"
      {% if include.limit and site.announcements.scrollable %}
        style="--news-visible-items: {{ news_visible_items }}"
        tabindex="0"
        role="region"
        aria-label="News updates, scroll to read all"
      {% endif %}
    >
      <table class="table table-sm table-borderless">
        {% assign news = site.news | reverse %}
        {% if include.limit and site.announcements.limit %}
          {% assign news_limit = site.announcements.limit %}
        {% else %}
          {% assign news_limit = news_size %}
        {% endif %}
        {% for item in news limit: news_limit %}
          <tr>
            <th
              scope="row"
              {% unless include.limit %}
                style="width: 20%"
              {% endunless %}
            >
              {{ item.date | date: '%b %d, %Y' }}
            </th>
            <td>
              {% if item.inline %}
                {{ item.content | remove: '<p>' | remove: '</p>' | emojify }}
              {% else %}
                <a class="news-title" href="{{ item.url | relative_url }}">{{ item.title }}</a>
              {% endif %}
            </td>
          </tr>
        {% endfor %}
      </table>
    </div>
  {% else %}
    <p>No news so far...</p>
  {% endif %}
</div>
